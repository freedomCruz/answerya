# Answerya — local environment contract
#
# Copy to a local env file and fill in real values. Placeholders only in this file.
# Validated at boot by packages/contracts/src/env.ts (Zod). A missing or malformed
# value fails immediately and names the offending field.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=answerya
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=answerya
POSTGRES_PORT=5432

# Host-run tooling (pnpm db:migrate) targets localhost on the published port.
# Compose overrides this per-service to postgres:5432 on the internal network.
# See CONTRIBUTING.md — "the two-DSN gotcha".
DATABASE_URL=postgresql://answerya:replace_me@localhost:5432/answerya

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Crypto -----------------------------------------------------------------
# 32 bytes hex-encoded (64 hex chars) for AES-256-GCM. Generate with:
#   openssl rand -hex 32
# Never commit a real key. Rotation is a version prefix, not a migration.
TOKEN_ENCRYPTION_KEY=replace_me_with_64_hex_chars

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
WORKER_HEALTH_PORT=3001

# --- Testing ----------------------------------------------------------------
# Fallback DSN used when Testcontainers cannot reach the Docker socket (WSL2).
TEST_DATABASE_URL=postgresql://answerya:replace_me@localhost:5432/answerya_test
